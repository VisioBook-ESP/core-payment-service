# Application
NODE_ENV=development
PORT=8087
API_PREFIX=/api/v1

# Database (PostgreSQL direct)
DATABASE_URL=postgresql://payment_app:localdevpass@localhost:5432/payment

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Services internes
USER_SERVICE_URL=http://core-user-service:8081
NOTIFICATION_SERVICE_URL=http://core-notification-service:8088

# Securite inter-services
# Pas de JWT_SECRET : la validation du token est assuree par la Gateway.
# Le UserIdGuard extrait le header x-user-id transmis par la Gateway.
INTERNAL_API_KEY=dev-internal-key

# Mock utilisateur (developpement local sans core-user-service disponible)
USER_SERVICE_MOCK=false

# Logging
LOG_LEVEL=info
