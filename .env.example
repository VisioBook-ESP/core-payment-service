# Application
NODE_ENV=development
PORT=8087
API_PREFIX=/api/v1

# Database (via core-database-service)
DATABASE_SERVICE_URL=http://core-database-service:8095

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Services internes
USER_SERVICE_URL=http://core-user-service:8081
NOTIFICATION_SERVICE_URL=http://core-notification-service:8088

# Securite inter-services
# Pas de JWT_SECRET : la validation du token est assuree par la Gateway.
# Le JwtAuthGuard transmet le token a core-user-service pour resoudre l'identite.
INTERNAL_API_KEY=dev-internal-key

# Mock utilisateur (developpement local sans core-user-service disponible)
USER_SERVICE_MOCK=false

# Redis (cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging
LOG_LEVEL=info
